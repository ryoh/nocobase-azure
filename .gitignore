# =============================================================================
# Terraform
# =============================================================================

# ローカル tfstate（リモートステートを使用する場合も念のため除外）
*.tfstate
*.tfstate.*
*.tfstate.backup

# プランファイル（機密情報を含む可能性あり）
*.tfplan
*.plan

# Terraform ワーキングディレクトリ
.terraform/
.terraform.lock.hcl

# クラッシュログ
crash.log
crash.*.log

# Override ファイル（ローカル上書き用）
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI 設定ファイル
.terraformrc
terraform.rc

# =============================================================================
# シークレット・認証情報（絶対にコミットしないこと）
# =============================================================================

# terraform.tfvars はシークレットを含む可能性があるため除外
# 環境別の変数ファイルは *.tfvars.example のみコミットする
*.tfvars
*.tfvars.json

# Azure 認証ファイル
.azure/
azure-credentials.json
service-principal.json

# 環境変数ファイル
.env
.env.*
*.env

# SSH 鍵
*.pem
*.key
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# =============================================================================
# ツール固有
# =============================================================================

# tflint
.tflint.hcl.lock

# checkov キャッシュ
.checkov_cache/
checkov_result_*.json

# trivy
trivy-results*.json
trivy-results*.sarif

# gitleaks レポート
gitleaks-report.*

# mise
.mise.local.toml

# =============================================================================
# OS / エディタ
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# VSCode（共有したい設定は除外しない）
.vscode/*.log

# JetBrains IDE
.idea/
*.iml

# Vim / Neovim
*.swp
*.swo
[._]*.s[a-v][a-z]
[._]*.sw[a-p]

# =============================================================================
# CI / ログ
# =============================================================================

*.log
logs/

# =============================================================================
# プロジェクト固有
# =============================================================================

# ビジュアルコンパニオン（brainstorming セッション）
.superpowers/

# ローカル開発用の一時ファイル
tmp/
temp/
scratch/
